{
  "name": "ace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "pnpm build:packages && concurrently --names engine,web,packages --prefix-colors cyan,magenta,yellow \"pnpm --filter @ace/server dev\" \"pnpm --filter @ace/web dev\" \"pnpm dev:packages\"",
    "dev:engine": "pnpm build:packages && pnpm --filter @ace/server dev",
    "build:packages": "pnpm --filter \"./packages/**\" build",
    "dev:web": "pnpm --filter @ace/web dev",
    "dev:packages": "tsc --build --watch --preserveWatchOutput packages/contracts packages/engine packages/storage-local packages/providers packages/guardrails packages/context packages/tools",
    "desktop:dev": "pnpm --filter @ace/desktop dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @ace/web test:e2e",
    "test:acceptance": "vitest run --config tests/acceptance/vitest.config.ts && pnpm test:acceptance:e2e",
    "test:providers": "pnpm -r test:providers",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:manual-pass": "playwright test --config tests/acceptance/manual-pass.config.ts",
    "test:acceptance:e2e": "playwright test --config tests/acceptance/playwright.config.ts"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "prettier": "^3.9.8",
    "typescript": "^5.9.3"
  }
}
